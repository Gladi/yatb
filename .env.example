# YATB - bot settings. Copy to .env (chmod 600) and never commit it.

# Required: bot token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=

# --- Optional (defaults shown) ---

# LibreTranslate, the last translation stage (self-hosted, no data leaves your server)
# LIBRETRANSLATE_URL=http://libretranslate:5000
# LIBRETRANSLATE_API_KEY=
# LIBRE_TIMEOUT=45

# AI stage: timeout per request (s), previous messages sent as context, description of the community
# AI_TIMEOUT=20
# AI_CONTEXT_LINES=4
# AI_CONTEXT_HINT=an online video game community (gaming, sci-fi and MMO terminology)

# Time budget (s) for all AI/paid stages of one message before falling back to LibreTranslate
# CHAIN_BUDGET=30

# Let Google Translate detect the source language (1) or always use the channel language (0)
# GOOGLE_AUTODETECT=1

# Also translate messages and mirror reactions from other bots (1)
# BRIDGE_BOTS=0

# Remove old per-server command registrations once at startup (1), e.g. after a test phase
# CLEANUP_GUILD_COMMANDS=0

# Paths inside the container (normally set by docker-compose.yml)
# YATB_DB_FILE=/app/data/bridge_bot.db
# YATB_STATS_DIR=/app/stats
# YATB_PROVIDERS_FILE=/app/config/providers.toml
# YATB_MASTER_KEY_FILE=/run/secrets/yatb_master_key
# YATB_INTERNAL_TOKEN_FILE=/run/secrets/yatb_internal_token
# YATB_INTERNAL_PORT=8081
